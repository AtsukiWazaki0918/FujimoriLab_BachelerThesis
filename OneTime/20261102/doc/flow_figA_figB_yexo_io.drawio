<mxfile host="app.diagrams.net" type="device"><diagram name="figA・figB（外生収量）" id="figA・figB（外生収量）"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="1196" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="外生収量の入力と出力の比較（figA・figB）の図ができるまで" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1220" height="30" as="geometry"/></mxCell><mxCell id="c4" value="図：output/figA_yexo_io_growth.png（2020→2050年の年平均成長率）と output/figB_yexo_io_change.png（2050年の NoCC 比の変化率）。プログラム：prog/figA_yexo_io_growth.py（figB_yexo_io_change.py と中身は同じ）。1つの箱が1ステップ（単位換算か集計を1回）。各箱に、そのステップの後の単位・品目・地域を書いた。赤 = 入力側（散布図の横軸）、青 = 出力側（縦軸）、緑 = 図、灰色の点線 = 参考（このフォルダの外での計算）。" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="54" width="1220" height="46" as="geometry"/></mxCell><mxCell id="c5" value="入力側：ClimateShifters2 から直接（横軸）" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="440" height="26" as="geometry"/></mxCell><mxCell id="c6" value="出力側：AIM-ALPHA の出力（縦軸）" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="110" width="440" height="26" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;I0 入力データ：define/ClimateShifters2.gdx（両方の出発点）&lt;/b&gt;&lt;br&gt;&lt;b&gt;変数&lt;/b&gt;：CEXO（気候変動による収量の年成長率）、OZYEXO（気候変動＋オゾン）、AREA（収穫面積）、iso2cty（国と CTY の対応）&lt;br&gt;&lt;b&gt;単位&lt;/b&gt;：CEXO・OZYEXO：年成長率 g [-]、AREA：1000 ha&lt;br&gt;&lt;b&gt;次元&lt;/b&gt;：IMPACT の品目 j（41）× CTY（156）× land（灌漑 air・天水 arf・合計 tot）× 気候モデル × rcp（nocc、rcp2p6、rcp7p0）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="144" width="1220" height="76" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;I1 選ぶ（合計・オゾン・気候）&lt;/b&gt;&lt;br&gt;&lt;b&gt;処理&lt;/b&gt;：land = tot を選ぶ。CEXO をオゾンなし（woO3）、OZYEXO をオゾンあり（wO3）として使う。rcp を気候（NoCC、RCP26、RCP70）とする&lt;br&gt;&lt;b&gt;単位&lt;/b&gt;：g [-]&lt;br&gt;&lt;b&gt;品目&lt;/b&gt;：j（41）&lt;br&gt;&lt;b&gt;地域&lt;/b&gt;：CTY（156）&lt;br&gt;&lt;b&gt;シナリオ&lt;/b&gt;：気候3 × オゾン2 = 6（緩和策の区別は無い）&lt;br&gt;&lt;b&gt;重み&lt;/b&gt;：AREA（land = tot）[1000 ha]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="440" height="136" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;O1 AIM-ALPHA の計算（研究室のサーバー）&lt;/b&gt;&lt;br&gt;&lt;b&gt;収量&lt;/b&gt;：j の g を単純平均してモデルの品目 c にし、2020年から30年の複利で伸ばす → yldWat [t/ha]（c × 流域 × 国 × 灌漑/天水）。2026-11-04 に確認&lt;br&gt;&lt;b&gt;対応&lt;/b&gt;：define/impact_c.map（j → c）、define/impact_cty.map（流域×CTY → 国）&lt;br&gt;&lt;b&gt;計算&lt;/b&gt;：この収量で生産・需要・価格を解き、12シナリオを出力する" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="800" y="250" width="440" height="91" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;I2 単位換算（成長率 → 指標）&lt;/b&gt;&lt;br&gt;&lt;b&gt;figA&lt;/b&gt;：g をそのまま使う（年成長率）&lt;br&gt;&lt;b&gt;figB&lt;/b&gt;：chg = ((1 + g_シナリオ) ÷ (1 + g_nocc))^30 − 1（2050年の NoCC 比の変化率）&lt;br&gt;&lt;b&gt;単位&lt;/b&gt;：[-]&lt;br&gt;&lt;b&gt;品目&lt;/b&gt;：j（41）&lt;br&gt;&lt;b&gt;地域&lt;/b&gt;：CTY（156）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="416" width="440" height="106" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;O2 モデルの出力の集計：data/AGMIP_all_scenario.gdx&lt;/b&gt;&lt;br&gt;&lt;b&gt;変数&lt;/b&gt;：AGMIP_agg の YEXO（外生収量）&lt;br&gt;&lt;b&gt;単位&lt;/b&gt;：fm t/ha（生重量）と dm t/ha（乾物重量）&lt;br&gt;&lt;b&gt;品目&lt;/b&gt;：AgMIP の品目（wht, RIC, CGR, OSD, SGC など）&lt;br&gt;&lt;b&gt;地域&lt;/b&gt;：AIM-ALPHA の17地域（CHN, IND, JPN, XSE, …）など&lt;br&gt;&lt;b&gt;シナリオ・年&lt;/b&gt;：12シナリオ × 2015–2050年&lt;br&gt;&lt;b&gt;注&lt;/b&gt;：国・流域・品目から地域・AgMIP の品目への集計はモデルの出力処理で行われる。重みは確認していない" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="416" width="440" height="136" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;I3 品目の対応&lt;/b&gt;&lt;br&gt;&lt;b&gt;対応&lt;/b&gt;：define/impact_c.map（j → c）と define/AgMIP_c.map（c → AgMIP の品目）を組み合わせる。結果を define/j2agmip5.csv に書き出した&lt;br&gt;&lt;b&gt;品目&lt;/b&gt;：j（41）→ AgMIP の5作物（WHT, RIC, CGR, OSD, SGC）。対応するのは22の j で、ほかは使わない&lt;br&gt;&lt;b&gt;単位&lt;/b&gt;：[-]&lt;br&gt;&lt;b&gt;地域&lt;/b&gt;：CTY（156）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="582" width="440" height="121" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="c12" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;O3 選ぶ（単位・品目・地域・年）&lt;/b&gt;&lt;br&gt;&lt;b&gt;処理&lt;/b&gt;：fm t/ha、5作物、17地域、2020年と2050年を選ぶ&lt;br&gt;&lt;b&gt;単位&lt;/b&gt;：fm t/ha&lt;br&gt;&lt;b&gt;品目&lt;/b&gt;：5作物&lt;br&gt;&lt;b&gt;地域&lt;/b&gt;：AIM-ALPHA の17地域&lt;br&gt;&lt;b&gt;シナリオ&lt;/b&gt;：12" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="582" width="440" height="106" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="c14" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;I4 地域の対応&lt;/b&gt;&lt;br&gt;&lt;b&gt;対応&lt;/b&gt;：iso2cty（ClimateShifters2）と cty_reg_map（data/all_scenario_global_17.gdx）。複数国の CTY は本体国の地域。対応が取れない7つ（CHM→CHN、CHP→XER、ISL→XER、HRV→XER、FRP→XE25、OSA→XSE、OAO→XAF）はプログラムで指定。結果を define/cty2reg_input.csv に書き出した&lt;br&gt;&lt;b&gt;地域&lt;/b&gt;：CTY（156）→ AIM-ALPHA の17地域&lt;br&gt;&lt;b&gt;品目&lt;/b&gt;：5作物&lt;br&gt;&lt;b&gt;単位&lt;/b&gt;：[-]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="733" width="440" height="136" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="c16" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;O4 単位換算（収量 → 指標）&lt;/b&gt;&lt;br&gt;&lt;b&gt;figA&lt;/b&gt;：out_g = ((YEXO_2050 ÷ YEXO_2020)^(1/30) − 1) × 100 [%/年]&lt;br&gt;&lt;b&gt;figB&lt;/b&gt;：out_chg = (YEXO_シナリオ,2050 ÷ YEXO_同じ緩和策の NoCC_woO3,2050 − 1) × 100 [%]&lt;br&gt;&lt;b&gt;品目&lt;/b&gt;：5作物&lt;br&gt;&lt;b&gt;地域&lt;/b&gt;：17地域&lt;br&gt;&lt;b&gt;シナリオ&lt;/b&gt;：12" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="733" width="440" height="121" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="c18" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;I5 集計（面積加重平均）&lt;/b&gt;&lt;br&gt;&lt;b&gt;式&lt;/b&gt;：in_g = Σ g × w ÷ Σ w × 100／in_chg = Σ chg × w ÷ Σ w × 100（w = AREA、w &amp;gt; 0 の組。品目×地域ごとに j と CTY で合計）&lt;br&gt;&lt;b&gt;単位&lt;/b&gt;：figA：%/年、figB：%&lt;br&gt;&lt;b&gt;品目&lt;/b&gt;：5作物&lt;br&gt;&lt;b&gt;地域&lt;/b&gt;：17地域&lt;br&gt;&lt;b&gt;シナリオ&lt;/b&gt;：6" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="899" width="440" height="121" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="c20" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;図 散布図：output/figA_yexo_io_growth.png（x = in_g、y = out_g）と output/figB_yexo_io_change.png（x = in_chg、y = out_chg）&lt;/b&gt;&lt;br&gt;&lt;b&gt;結合&lt;/b&gt;：品目 × 地域 × 気候 × オゾン で入力と出力を結ぶ。入力は緩和策（BaU、500C）で共通&lt;br&gt;&lt;b&gt;中身&lt;/b&gt;：パネル = 5作物。点 = 17地域 × 12シナリオ（figB は NoCC_woO3 を除く）。破線 = 1:1 線&lt;br&gt;&lt;b&gt;表&lt;/b&gt;：data/yexo_io_check.csv・.xlsx（散布図の数値と統計）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1050" width="1220" height="76" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="c22" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>